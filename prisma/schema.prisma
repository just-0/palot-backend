generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  nombre String  @id
  hashed String
  Playa  Playa[] @relation("AdminPlaya")
}

model Playa {
  id_playa     Int       @id @default(autoincrement())
  nombre_admin String
  nombre       String
  direccion    String?
  tarifaAuto   Float?
  tarifaMoto   Float?
  horaAbierto  DateTime?
  horaCerrado  DateTime?
  usuarioAbrio String?
  usuarioCerro String?
  estado       String    @default("cerrado") // "abierto" o "cerrado"
  facturacion  Boolean   @default(false) // true si requiere facturación SUNAT
  Auto         Auto[]
  Moto         Moto[]
  Admin        Admin     @relation("AdminPlaya", fields: [nombre_admin], references: [nombre])
  Trabaja      Trabaja[]

  @@index([nombre_admin], map: "Playa_nombre_admin_fkey")
}

model Auto {
  id_auto      Int       @id @default(autoincrement())
  id_playa     Int
  placa        String
  hora_entrada DateTime
  hora_salida  DateTime?
  image        String?
  state        Int?
  Playa        Playa     @relation(fields: [id_playa], references: [id_playa])
  Boleta       Boleta[]
  Ticket       Ticket[]
  Factura      Factura[]
  Cliente      Cliente?

  @@index([id_playa], map: "Auto_id_playa_fkey")
}

model Moto {
  id_moto      Int       @id @default(autoincrement())
  id_playa     Int
  placa        String
  hora_entrada DateTime
  hora_salida  DateTime?
  image        String?
  state        Int?
  Playa        Playa     @relation(fields: [id_playa], references: [id_playa])
  Boleta       Boleta[]
  Ticket       Ticket[]
  Factura      Factura[]

  @@index([id_playa], map: "Moto_id_playa_fkey")
}

model Cliente {
  id_cliente Int       @id @default(autoincrement())
  id_auto    Int?      @unique
  nombre     String
  dni_ruc    String
  Boleta     Boleta[]
  Ticket     Ticket[]
  Factura    Factura[]
  Auto       Auto?     @relation(fields: [id_auto], references: [id_auto])
}

model Boleta {
  id_boleta     Int      @id @default(autoincrement())
  id_auto       Int?
  id_moto       Int?
  id_cliente    Int?
  total_pagar   Float
  fecha_emision DateTime
  Auto          Auto?    @relation(fields: [id_auto], references: [id_auto])
  Moto          Moto?    @relation(fields: [id_moto], references: [id_moto])
  Cliente       Cliente? @relation(fields: [id_cliente], references: [id_cliente])

  @@index([id_auto], map: "Boleta_id_auto_fkey")
  @@index([id_moto], map: "Boleta_id_moto_fkey")
  @@index([id_cliente], map: "Boleta_id_cliente_fkey")
}

model Ticket {
  id_ticket     Int      @id @default(autoincrement())
  id_auto       Int?
  id_moto       Int?
  id_cliente    Int?
  total_pagar   Float
  fecha_emision DateTime
  Auto          Auto?    @relation(fields: [id_auto], references: [id_auto])
  Moto          Moto?    @relation(fields: [id_moto], references: [id_moto])
  Cliente       Cliente? @relation(fields: [id_cliente], references: [id_cliente])

  @@index([id_auto], map: "Ticket_id_auto_fkey")
  @@index([id_moto], map: "Ticket_id_moto_fkey")
  @@index([id_cliente], map: "Ticket_id_cliente_fkey")
}

model Factura {
  id_factura    Int      @id @default(autoincrement())
  id_auto       Int?
  id_moto       Int?
  id_cliente    Int?
  total_pagar   Float
  fecha_emision DateTime
  Auto          Auto?    @relation(fields: [id_auto], references: [id_auto])
  Moto          Moto?    @relation(fields: [id_moto], references: [id_moto])
  Cliente       Cliente? @relation(fields: [id_cliente], references: [id_cliente])

  @@index([id_auto], map: "Factura_id_auto_fkey")
  @@index([id_moto], map: "Factura_id_moto_fkey")
  @@index([id_cliente], map: "Factura_id_cliente_fkey")
}

model Empleado {
  id_empleado Int       @id @default(autoincrement())
  nombre      String
  hashed      String
  Trabaja     Trabaja[]
}

model Trabaja {
  id_empleado Int
  id_playa    Int
  Empleado    Empleado @relation(fields: [id_empleado], references: [id_empleado])
  Playa       Playa    @relation(fields: [id_playa], references: [id_playa])

  @@id([id_empleado, id_playa])
  @@index([id_playa], map: "Trabaja_id_playa_fkey")
}
